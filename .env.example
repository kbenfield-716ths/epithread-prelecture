# Anthropic API key — set in Vercel dashboard, never commit this file with real values
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel Blob (debrief storage) — DO NOT set anything below by hand.
# In the Vercel dashboard: project → Storage tab → Create Database (or
# Connect Database) → Blob, connected to this project with Production
# checked. Vercel's current Storage flow authenticates via OIDC by default —
# it injects BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY (using the system
# VERCEL_OIDC_TOKEN under "Enable access to System Environment Variables"),
# NOT a static BLOB_READ_WRITE_TOKEN. @vercel/blob's put() picks either form
# up automatically — api/debrief.js just checks that one of them exists.
# BLOB_STORE_ID=set_automatically_by_vercel_once_a_blob_store_is_connected
# BLOB_WEBHOOK_PUBLIC_KEY=set_automatically_by_vercel_once_a_blob_store_is_connected

# ── Legacy: no longer used ──────────────────────────────────────────────
# api/debrief.js previously wrote debrief records to a GitHub repo via the
# Contents API. That approach is retired (a misconfigured GITHUB_DEBRIEF_REPO
# silently dropped 79 student submissions on 2026-08-18 through 08-26) in
# favor of Vercel Blob above. These are kept here only as a record of what
# used to be required — safe to delete once you've confirmed Blob is working.
# GITHUB_TOKEN=your_github_token_here
# GITHUB_DEBRIEF_REPO=your-org/epithread-debriefs
# GITHUB_DEBRIEF_BRANCH=main
